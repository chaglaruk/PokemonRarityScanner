{
  "$defs": {
    "reviewEntry": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "candidateId": {
                "pattern": "^s25_2026_dev_[0-9]{3}$"
              }
            },
            "required": [
              "candidateId"
            ]
          },
          "then": {
            "properties": {
              "lane": {
                "const": "development_candidate"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "candidateId": {
                "pattern": "^s25_2026_holdout_[0-9]{3}$"
              }
            },
            "required": [
              "candidateId"
            ]
          },
          "then": {
            "properties": {
              "lane": {
                "const": "prospective_holdout_candidate"
              }
            }
          }
        }
      ],
      "properties": {
        "candidateId": {
          "pattern": "^s25_2026_(dev|holdout)_[0-9]{3}$",
          "type": "string"
        },
        "lane": {
          "enum": [
            "development_candidate",
            "prospective_holdout_candidate"
          ],
          "type": "string"
        },
        "privacyDisposition": {
          "const": "NOT_REVIEWED",
          "type": "string"
        },
        "provenanceDisposition": {
          "const": "NOT_VERIFIED",
          "type": "string"
        },
        "reviewStatus": {
          "const": "UNKNOWN",
          "type": "string"
        },
        "reviewerNotes": {
          "const": "",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "suggestionsPromoted": {
          "const": false,
          "type": "boolean"
        },
        "truthFields": {
          "additionalProperties": false,
          "maxProperties": 0,
          "type": "object"
        }
      },
      "required": [
        "candidateId",
        "lane",
        "sha256",
        "reviewStatus",
        "privacyDisposition",
        "provenanceDisposition",
        "truthFields",
        "reviewerNotes",
        "suggestionsPromoted"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Strict schema for the deterministic deferred-review export. It cannot represent approvals, verified truth, promoted suggestions, or holdout truth.",
  "properties": {
    "completionStatus": {
      "const": "INCOMPLETE",
      "type": "string"
    },
    "developmentRecords": {
      "const": 100,
      "type": "integer"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/reviewEntry"
      },
      "maxItems": 120,
      "minItems": 120,
      "type": "array"
    },
    "gateStatus": {
      "const": "OPEN",
      "type": "string"
    },
    "holdoutRecords": {
      "const": 20,
      "type": "integer"
    },
    "holdoutTruthExposureCount": {
      "const": 0,
      "type": "integer"
    },
    "privacyApprovedCount": {
      "const": 0,
      "type": "integer"
    },
    "provenanceVerifiedCount": {
      "const": 0,
      "type": "integer"
    },
    "reviewType": {
      "const": "UNKNOWN_ONLY_EXPORT",
      "type": "string"
    },
    "schemaVersion": {
      "const": 1,
      "type": "integer"
    },
    "sourceManifestDatasetId": {
      "const": "candidate_2026_s25",
      "type": "string"
    },
    "sourceManifestSchemaVersion": {
      "const": 1,
      "type": "integer"
    },
    "suggestionsPromotedCount": {
      "const": 0,
      "type": "integer"
    },
    "totalRecords": {
      "const": 120,
      "type": "integer"
    },
    "truthCompletedCount": {
      "const": 0,
      "type": "integer"
    }
  },
  "required": [
    "schemaVersion",
    "sourceManifestDatasetId",
    "sourceManifestSchemaVersion",
    "gateStatus",
    "completionStatus",
    "reviewType",
    "totalRecords",
    "developmentRecords",
    "holdoutRecords",
    "truthCompletedCount",
    "privacyApprovedCount",
    "provenanceVerifiedCount",
    "suggestionsPromotedCount",
    "holdoutTruthExposureCount",
    "entries"
  ],
  "title": "Manual Gate A UNKNOWN-only Ledger",
  "type": "object"
}
